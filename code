"QuizFrame.java": r'''import javax.swing.*;
import java.awt.*;
import java.util.List;

public class QuizFrame extends JFrame {
    private final String studentName;
    private final List<Question> questions;
    private int currentQuestion = 0;
    private int score = 0;
    private int timeLeft = 30;

    private final JLabel questionNumberLabel = new JLabel();
    private final JLabel timerLabel = new JLabel();
    private final JLabel questionLabel = new JLabel();
    private final JRadioButton[] optionButtons = new JRadioButton[4];
    private final ButtonGroup group = new ButtonGroup();
    private final JButton nextButton = new JButton("NEXT");
    private final Timer timer;

    public QuizFrame(String studentName) {
        this.studentName = studentName;
        this.questions = new QuizManager().getQuestions().subList(0, 15);

        setTitle("Java Online Quiz - " + studentName);
        setSize(760, 520);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);

        JPanel main = new JPanel(new BorderLayout(15, 15));
        main.setBorder(BorderFactory.createEmptyBorder(20, 25, 20, 25));

        JPanel top = new JPanel(new BorderLayout());
        questionNumberLabel.setFont(new Font("Arial", Font.BOLD, 16));
        timerLabel.setFont(new Font("Arial", Font.BOLD, 16));
        timerLabel.setHorizontalAlignment(SwingConstants.RIGHT);
        top.add(questionNumberLabel, BorderLayout.WEST);
        top.add(timerLabel, BorderLayout.EAST);

        questionLabel.setFont(new Font("Arial", Font.BOLD, 18));
        questionLabel.setVerticalAlignment(SwingConstants.TOP);
        questionLabel.setBorder(BorderFactory.createEmptyBorder(15, 10, 15, 10));

        JPanel optionsPanel = new JPanel();
        optionsPanel.setLayout(new BoxLayout(optionsPanel, BoxLayout.Y_AXIS));
        for (int i = 0; i < 4; i++) {
            optionButtons[i] = new JRadioButton();
            optionButtons[i].setFont(new Font("Arial", Font.PLAIN, 16));
            optionButtons[i].setAlignmentX(Component.LEFT_ALIGNMENT);
            optionButtons[i].setBorder(BorderFactory.createEmptyBorder(8, 8, 8, 8));
            group.add(optionButtons[i]);
            optionsPanel.add(optionButtons[i]);
        }

        JPanel bottom = new JPanel(new FlowLayout(FlowLayout.RIGHT));
        nextButton.setFont(new Font("Arial", Font.BOLD, 15));
        nextButton.addActionListener(e -> submitAndNext());
        bottom.add(nextButton);

        main.add(top, BorderLayout.NORTH);
        main.add(questionLabel, BorderLayout.CENTER);

        JPanel center = new JPanel(new BorderLayout());
        center.add(questionLabel, BorderLayout.NORTH);
        center.add(optionsPanel, BorderLayout.CENTER);
        main.add(center, BorderLayout.CENTER);
        main.add(bottom, BorderLayout.SOUTH);

        add(main);

        timer = new Timer(1000, e -> tick());
        loadQuestion();
        timer.start();
        setVisible(true);
    }

    private void loadQuestion() {
        Question q = questions.get(currentQuestion);
        questionNumberLabel.setText("Question " + (currentQuestion + 1) + " of " + questions.size());
        questionLabel.setText("<html><body style='width: 650px'>" +
                (currentQuestion + 1) + ". " + q.getQuestion() + "</body></html>");

        String[] options = q.getOptions();
        group.clearSelection();
        for (int i = 0; i < 4; i++) {
            optionButtons[i].setText((char)('A' + i) + ". " + options[i]);
        }

        timeLeft = 30;
        updateTimerLabel();
        nextButton.setText(currentQuestion == questions.size() - 1 ? "SUBMIT QUIZ" : "NEXT");
    }

    private void tick() {
        timeLeft--;
        updateTimerLabel();
        if (timeLeft <= 0) {
            submitAndNext();
        }
    }

    private void updateTimerLabel() {
        timerLabel.setText("Time: " + timeLeft + " sec");
    }

    private void submitAndNext() {
        int selected = -1;
        for (int i = 0; i < 4; i++) {
            if (optionButtons[i].isSelected()) {
                selected = i;
                break;
            }
        }

        if (selected == -1 && timeLeft > 0) {
            int choice = JOptionPane.showConfirmDialog(this,
                    "You have not selected an answer. Continue?",
                    "No Answer", JOptionPane.YES_NO_OPTION);
            if (choice != JOptionPane.YES_OPTION) return;
        }

        if (selected == questions.get(currentQuestion).getCorrectAnswer()) {
            score++;
        }

        if (currentQuestion == questions.size() - 1) {
            timer.stop();
            dispose();
            new ResultFrame(studentName, score, questions.size());
        } else {
            currentQuestion++;
            loadQuestion();
        }
    }
}
''',

"ResultFrame.java": r'''import javax.swing.*;
import java.awt.*;

public class ResultFrame extends JFrame {
    public ResultFrame(String studentName, int score, int total) {
        setTitle("Quiz Result");
        setSize(560, 430);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setResizable(false);

        double percentage = (score * 100.0) / total;
        String grade;
        if (percentage >= 90) grade = "A+";
        else if (percentage >= 80) grade = "A";
        else if (percentage >= 70) grade = "B";
        else if (percentage >= 60) grade = "C";
        else if (percentage >= 50) grade = "D";
        else grade = "F";

        JPanel panel = new JPanel();
        panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
        panel.setBorder(BorderFactory.createEmptyBorder(35, 35, 35, 35));

        JLabel title = new JLabel("QUIZ COMPLETED", SwingConstants.CENTER);
        title.setAlignmentX(Component.CENTER_ALIGNMENT);
        title.setFont(new Font("Arial", Font.BOLD, 28));

        JLabel name = new JLabel("Student: " + studentName);
        name.setAlignmentX(Component.CENTER_ALIGNMENT);
        name.setFont(new Font("Arial", Font.PLAIN, 18));

        JLabel scoreLabel = new JLabel("Score: " + score + " / " + total);
        scoreLabel.setAlignmentX(Component.CENTER_ALIGNMENT);
        scoreLabel.setFont(new Font("Arial", Font.BOLD, 24));

        JLabel percent = new JLabel(String.format("Percentage: %.1f%%", percentage));
        percent.setAlignmentX(Component.CENTER_ALIGNMENT);
        percent.setFont(new Font("Arial", Font.PLAIN, 20));

        JLabel gradeLabel = new JLabel("Grade: " + grade);
        gradeLabel.setAlignmentX(Component.CENTER_ALIGNMENT);
        gradeLabel.setFont(new Font("Arial", Font.BOLD, 22));

        JButton restart = new JButton("TAKE QUIZ AGAIN");
        restart.setAlignmentX(Component.CENTER_ALIGNMENT);
        restart.setFont(new Font("Arial", Font.BOLD, 15));
        restart.addActionListener(e -> {
            dispose();
            new LoginFrame();
        });

        JButton exit = new JButton("EXIT");
        exit.setAlignmentX(Component.CENTER_ALIGNMENT);
        exit.setFont(new Font("Arial", Font.BOLD, 15));
        exit.addActionListener(e -> System.exit(0));

        panel.add(title);
        panel.add(Box.createVerticalStrut(25));
        panel.add(name);
        panel.add(Box.createVerticalStrut(15));
        panel.add(scoreLabel);
        panel.add(percent);
        panel.add(gradeLabel);
        panel.add(Box.createVerticalStrut(25));
        panel.add(restart);
        panel.add(Box.createVerticalStrut(10));
        panel.add(exit);

        add(panel);
        setVisible(true);
    }
}
